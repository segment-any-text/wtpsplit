.venv/
.venv-*/
build
dist
wandb
output*
# Anchored to the repository root. Unanchored `data` also matched `wtpsplit/data`,
# which made the `!wtpsplit/data/*.txt` negation below a no-op: git does not descend
# into an excluded directory, so files inside it cannot be re-included.
/data
!/data/iwslt_2012
.vscode
__pycache__
.ipynb_checkpoints
external
*.egg-info
notebooks
final_outputs
.cache*
data_subset/**
*.pth
*.zip
*.bin
*.html
*.csv
*.png
*.txt
!wtpsplit/data/*.txt
*.log
xlmr-*/**
**/checkpoint-*/**

# Keep small, reproducible research manifests under version control while
# continuing to ignore corpora, model artifacts, and other generated data.
!/data/
/data/*
!/data/manifests/
/data/manifests/*
!/data/manifests/*.csv
!/data/manifests/*.json
